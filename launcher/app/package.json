{
  "name": "umk3-launcher",
  "version": "0.1.5-alpha",
  "description": "UMK3 PC port launcher - arcade shell (Electron)",
  "main": "main.js",
  "author": "UMK3 Recomp",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win zip portable --x64",
    "dist:linux": "electron-builder --linux tar.gz AppImage --x64",
    "test": "node --test test/*.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.umk3recomp.launcher",
    "productName": "UMK3 LAUNCHER",
    "executableName": "UMK3-Launcher",
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../../src",
        "to": "src"
      },
      {
        "from": "../../tools/build",
        "to": "tools/build"
      },
      {
        "from": "../aditional textures",
        "to": "launcher/aditional textures"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "UMK3-Launcher-Windows.exe"
    },
    "linux": {
      "target": [
        "tar.gz",
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}